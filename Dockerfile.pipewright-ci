# Extract the Pipewright binary and the /data directory from the author-published image
FROM ghcr.io/huangchengsir/pipewright:latest AS pipewright

# Prepare Docker CLI and Plugins
FROM docker:27-cli AS docker-cli

# Use a distroless base with glibc as the final runtime environment
FROM gcr.io/distroless/base-debian12:nonroot

# Overlay the author's mirror content (Pipewright main program, data directory)
COPY --from=pipewright /pipewright /pipewright
COPY --from=pipewright --chown=65532:65532 /data /data

# Install Docker CLI and compose/buildx plugins
COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=docker-cli /usr/local/libexec/docker/cli-plugins/ /usr/local/libexec/docker/cli-plugins/

WORKDIR /data
EXPOSE 8080
ENTRYPOINT ["/pipewright"]
